// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  password  String?  // nullable — Google-only users won't have a password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
}

model Account {
  id                String    @id @default(uuid())
  provider          String    // "google", "email", "ticktick", etc.
  providerAccountId String    // Provider's unique user ID (e.g., Google sub or TickTick user ID)
  accessToken       String?   // OAuth access token or API key token
  refreshToken      String?   // OAuth refresh token (for token refresh if needed)
  tokenExpiry       DateTime?

  // TickTick-specific fields
  ticktickId        String?   // TickTick user ID (from API response)
  ticktickAccessToken String?   // TickTick API access token / API key
  ticktickRefreshToken String?   // TickTick refresh token (if using OAuth 2.0)
  ticktickTokenExpiry DateTime? // Token expiry time

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
